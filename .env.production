# ==============================================================================
# NexusLMS Enterprise — Production Environment Variables for Vercel Hosting
# Repository: https://github.com/Brijesh1990/LLM-VibeCode-App.git
# ==============================================================================

# 1. APPLICATION & SERVER RUNTIME
APP_NAME=NexusLMS Enterprise
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# 2. JWT SECURITY & CRYPTOGRAPHIC SECRETS (Generate secure 64-char strings)
SECRET_KEY=sk_live_nexus_lms_super_secret_production_key_2026_hs256_vibe
JWT_SECRET_KEY=jwt_live_nexus_lms_signing_secret_key_2026_hs256_enterprise
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 3. DATABASE CONFIGURATION (Serverless SQLite Auto-Seeded by default; replace with Cloud MySQL URI for persistent prod)
DATABASE_URL=sqlite:////tmp/lms_db.db
AUTO_SEED_DB=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lms_db
DB_USER=root
DB_PASSWORD=admin

# 4. FRONTEND & CORS ORIGIN CONFIGURATION
FRONTEND_URL=https://llm-vibe-code-app.vercel.app
BACKEND_URL=https://llm-vibe-code-app.vercel.app
CORS_ORIGINS=https://llm-vibe-code-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# 5. EMAIL / SMTP CREDENTIALS (SendGrid, Mailgun, AWS SES, or Gmail App Password)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key_or_app_password
SMTP_FROM_EMAIL=noreply@nexuslms.edu

# 6. STORAGE & MEDIA ASSETS (Local ephemeral or S3/Cloudflare R2)
STORAGE_PROVIDER=local
STORAGE_BUCKET=nexuslms-media-assets
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=pdf,ppt,pptx,doc,docx,zip,jpg,jpeg,png,mp4

# 7. PAYMENT GATEWAY SECRETS (Razorpay / Sandbox Testing Key)
PAYMENT_GATEWAY=razorpay_test
PAYMENT_KEY_ID=rzp_test_NexusLms2026Key
PAYMENT_KEY_SECRET=rzp_test_secret_nexus2026
PAYMENT_CURRENCY=USD

# 8. FRONTEND PUBLIC BUILD VARIABLES (Vite Client Bundler)
VITE_APP_NAME=NexusLMS Enterprise
VITE_API_BASE_URL=/api/v1
VITE_APP_ENV=production
VITE_PAYMENT_KEY_ID=rzp_test_NexusLms2026Key
VITE_PAYMENT_GATEWAY=razorpay_test
VITE_PAYMENT_CURRENCY=USD
