# --- Python / FastAPI Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Local SQLite / Test DBs & Uploaded Media Artifacts
*.db
*.sqlite
*.sqlite3
backend/uploads/*
!backend/uploads/.gitkeep

# --- Node.js / React 19 + Vite Frontend ---
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# --- IDEs, Editors & OS Files ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

.vercel
